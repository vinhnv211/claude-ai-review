{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewTask",
  "type": "object",
  "required": ["task_id", "domain", "assigned_agent", "objective", "scope_files", "priority"],
  "properties": {
    "task_id": {"type": "string"},
    "domain": {"type": "string"},
    "assigned_agent": {"type": "string"},
    "objective": {"type": "string"},
    "scope_files": {"type": "array", "items": {"type": "string"}},
    "priority": {"type": "string", "enum": ["high", "medium", "low"]},
    "focus_tags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
